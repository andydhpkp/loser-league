{
  "dependencies": {
    "bcrypt": "^5.0.1",
    "connect-session-sequelize": "^7.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "express-handlebars": "^6.0.3",
    "express-session": "^1.17.2",
    "google-auth-library": "^9.0.0",
    "mysql2": "^2.3.3",
    "nodemailer": "^6.7.3",
    "sequelize": "^6.17.0",
    "sequelize-cli": "^6.6.1"
  },
  "name": "loser-league",
  "description": "",
  "version": "1.0.0",
  "main": "server/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:smoke",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:unit:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include='server/**/*.js' --test-coverage-include='config/test-database.js' --test-coverage-include='models/*.js' --test-coverage-include='controllers/api/**/*.js' --test-coverage-include='public/js/modules/league-stats.js' \"test/unit/**/*.test.js\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "test:smoke": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:smoke:webkit": "MOBILE_WEBKIT=1 PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=webkit-iphone",
    "lint:browser": "eslint public/js",
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "league:bootstrap": "node scripts/bootstrap-league-season.js",
    "seeds": "node seeds/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andydhpkp/loser-league.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andydhpkp/loser-league/issues"
  },
  "homepage": "https://github.com/andydhpkp/loser-league#readme",
  "web": "node index.js",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.0",
    "nodemon": "^2.0.15",
    "supertest": "^7.2.2"
  }
}
